# =============================================================================
# magicpin AI Challenge — Environment Configuration (.env)
# =============================================================================

# 1. Choose your provider: "openai", "anthropic", "gemini", "groq", "deepseek", "openrouter", "ollama"
LLM_PROVIDER=openai

# 2. Add your LLM API Key here (or use the provider-specific key below)
LLM_API_KEY=

# Provider-specific keys (optional, recognized automatically)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 3. Model selection (leave blank for defaults: gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash)
LLM_MODEL=

# 4. Bot URL (defaults to http://localhost:8080)
BOT_URL=http://localhost:8080
